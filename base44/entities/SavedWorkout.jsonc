{
  "name": "SavedWorkout",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the saved workout"
    },
    "description": {
      "type": "string",
      "description": "Description of the workout"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string"
          },
          "exercise_name": {
            "type": "string"
          },
          "target_reps": {
            "type": "number"
          },
          "target_time": {
            "type": "number"
          },
          "sets": {
            "type": "number"
          },
          "superset_with_next": {
            "type": "boolean"
          }
        }
      }
    },
    "workout_type": {
      "type": "string",
      "enum": [
        "time_based",
        "rep_based",
        "random"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_duration": {
      "type": "number",
      "description": "Estimated duration in minutes"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags like 'upper body', 'full body', etc."
    },
    "source": {
      "type": "string",
      "enum": ["artp", "program", "history", "custom"],
      "description": "Where it was saved from. 'artp' restarts in AiRTP (camera) with artp_settings"
    },
    "artp_settings": {
      "type": "object",
      "description": "AiRTP session settings to restore on Start",
      "properties": {
        "mode": { "type": "string" },
        "totalSets": { "type": "number" },
        "timePerEx": { "type": "number" },
        "repGoalPerEx": { "type": "number" },
        "targetRepsPerEx": { "type": "number" }
      }
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether this workout can be shared publicly"
    }
  },
  "required": [
    "name",
    "exercises",
    "workout_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}