{
  "name": "AIInsight",
  "type": "object",
  "properties": {
    "insight_date": {
      "type": "string",
      "format": "date"
    },
    "insight_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "adaptation",
        "warning",
        "achievement"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "workout",
        "nutrition",
        "recovery",
        "sleep",
        "hormones",
        "metabolism",
        "general"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "ai_adjustments": {
      "type": "object",
      "properties": {
        "calories_adjustment": {
          "type": "number"
        },
        "intensity_adjustment_percent": {
          "type": "number"
        },
        "protein_adjustment_g": {
          "type": "number"
        },
        "extra_rest_days": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "insight_date",
    "insight_type",
    "category",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}